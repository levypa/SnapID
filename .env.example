# ===================================
# SnapID - Configurações de Ambiente
# ===================================

# MongoDB Connection String
# Formato local: mongodb://localhost:27017/snapid
# Formato Atlas: mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/snapid
MONGO_URI=mongodb://localhost:27017/snapid

# Porta do servidor (padrão: 3000)
PORT=3000

# URL base pública do servidor (para gerar links de imagens)
# Em produção, use seu domínio: https://seudominio.com
BASE_URL=http://localhost:3000
